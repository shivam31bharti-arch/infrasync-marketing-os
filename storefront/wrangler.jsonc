{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "skillsync-site",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // Non-secret runtime vars MUST live here: `wrangler deploy` (every git build)
  // replaces dashboard plain-text vars with this block. Secrets (API keys) are
  // dashboard-managed and survive deploys — never put secrets in this file.
  "vars": {
    "SUPABASE_URL": "https://vqgqkhhrgaecigvvteha.supabase.co",
    "OMNIDIM_AGENT_ID": "244948",
    "SITE_URL": "https://infra-sync.online"
  }
}
