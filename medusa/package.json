{
  "name": "medusa-backend",
  "version": "0.1.0",
  "private": true,
  "description": "InfraSync commerce backend (Medusa v2) — local dev instance. Production lives on the VPS (infra/, Stage 2).",
  "scripts": {
    "dev": "medusa develop",
    "build:admin": "medusa build --admin-only",
    "start": "medusa start",
    "migrate": "medusa db:migrate",
    "seed": "medusa exec ./src/scripts/seed.ts"
  },
  "dependencies": {
    "@medusajs/cli": "^2.0.0",
    "@medusajs/framework": "^2.0.0",
    "@medusajs/medusa": "^2.0.0",
    "@mikro-orm/core": "^6.4.3",
    "@mikro-orm/knex": "^6.4.3",
    "@mikro-orm/migrations": "^6.4.3",
    "@mikro-orm/postgresql": "^6.4.3",
    "awilix": "^8.0.1",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  }
}
