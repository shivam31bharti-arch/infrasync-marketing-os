# Copy ONCE to .env (never re-run the copy — it overwrites!) and fill in.
# NEVER commit .env. Names only here.

# --- LLM router (free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=            # nvapi-... from build.nvidia.com

# --- data ---
SUPABASE_URL=              # https://<project-ref>.supabase.co (NOT the dashboard URL)
SUPABASE_ANON_KEY=         # "Publishable key" (sb_publishable_...) — legacy anon JWT also works
SUPABASE_SERVICE_ROLE_KEY= # "Secret key" (sb_secret_...) or legacy service_role — server-side only

# --- payments (hosted links; keys only needed for API-created links/webhooks later) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- infra (docker-compose on the VPS) ---
PG_PASS=
JWT_SECRET=

# --- email / messaging ---
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- research / media ---
YOUTUBE_DATA_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FIRECRAWL_API_URL=         # http://localhost:3002 when self-hosted

# --- analytics / ops ---
POSTHOG_PROJECT_KEY=
SENTRY_DSN=
POSTIZ_API_KEY=

DRAFTS_DASHBOARD=1
