# Copy to .env and fill in. NEVER commit .env. Names only here.

# --- LLM router (free tiers) ---
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=            # nvapi-... from build.nvidia.com

# --- data ---
SUPABASE_URL=              # https://<project-ref>.supabase.co (NOT the dashboard URL)
SUPABASE_ANON_KEY=         # new key system: the "Publishable key" (sb_publishable_...)
SUPABASE_SERVICE_ROLE_KEY= # new key system: the "Secret key" (sb_secret_...) — server-side only

# --- commerce (Medusa on the VPS) ---
MEDUSA_BACKEND_URL=        # https://api.infra-sync.online
MEDUSA_PUBLISHABLE_KEY=
MEDUSA_ADMIN_API_TOKEN=    # server-side only
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- infra (docker-compose on the VPS) ---
PG_PASS=
JWT_SECRET=
COOKIE_SECRET=

# --- email / messaging ---
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
LISTMONK_API_USER=
LISTMONK_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# --- research / media ---
YOUTUBE_DATA_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FIRECRAWL_API_URL=         # http://localhost:3002 when self-hosted

# --- analytics / ops ---
POSTHOG_PROJECT_KEY=
SENTRY_DSN=
POSTIZ_API_KEY=
